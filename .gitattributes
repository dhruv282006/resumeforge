# =============================================================================
# ResumeForge – .gitattributes
# Ensures consistent line endings across Windows, macOS, Linux contributors.
# =============================================================================

# Default: normalise all text files to LF in the repository
* text=auto eol=lf

# Explicitly text files
*.py        text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
*.js        text eol=lf
*.jsx       text eol=lf
*.json      text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.md        text eol=lf
*.txt       text eol=lf
*.sh        text eol=lf
*.env       text eol=lf
*.env.*     text eol=lf
*.toml      text eol=lf
*.cfg       text eol=lf
*.ini       text eol=lf
*.css       text eol=lf
*.html      text eol=lf
*.sql       text eol=lf
Makefile    text eol=lf
Dockerfile  text eol=lf
.gitignore  text eol=lf
.gitattributes text eol=lf

# Binary files — never mangle
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.svg       binary
*.pdf       binary
*.docx      binary
*.doc       binary
*.zip       binary
*.tar       binary
*.gz        binary
*.woff      binary
*.woff2     binary
*.ttf       binary
*.eot       binary
