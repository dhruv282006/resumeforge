# =============================================================================
# ResumeForge – Environment Variables Example
# =============================================================================
# INSTRUCTIONS:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in real values for your environment.
#   3. NEVER commit .env to version control.
#
# Docker networking note:
#   When services communicate inside Docker, use the service name as host
#   (e.g. "postgres", "redis"). For local development outside Docker, use
#   "localhost" instead.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME=ResumeForge
APP_VERSION=0.1.0

# Set to "true" to enable debug output and auto-reload
DEBUG=true

# One of: development | staging | production
ENVIRONMENT=development

# -----------------------------------------------------------------------------
# PostgreSQL Database
# -----------------------------------------------------------------------------
# Credentials used to initialise the postgres container and to connect from the
# backend.  If you change these you must also update DATABASE_URL below.
POSTGRES_USER=resumeforge
POSTGRES_PASSWORD=resumeforge_dev_password
POSTGRES_DB=resumeforge

# Async URL used by SQLAlchemy + asyncpg (inside Docker → host = "postgres")
DATABASE_URL=postgresql+asyncpg://resumeforge:resumeforge_dev_password@postgres:5432/resumeforge

# Sync URL used by Alembic migrations (inside Docker → host = "postgres")
DATABASE_URL_SYNC=postgresql://resumeforge:resumeforge_dev_password@postgres:5432/resumeforge

# SQLAlchemy connection pool settings
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
# Cache + Celery broker (inside Docker → host = "redis")
REDIS_URL=redis://redis:6379/0

# -----------------------------------------------------------------------------
# Celery (async task queue)
# -----------------------------------------------------------------------------
# Broker: Redis database 0
CELERY_BROKER_URL=redis://redis:6379/0

# Results backend: Redis database 1 (keeps results separate from broker)
CELERY_RESULT_BACKEND=redis://redis:6379/1

# -----------------------------------------------------------------------------
# LLM / AI Provider
# -----------------------------------------------------------------------------
# Which LLM backend to use.  Options: ollama | openai | gemini
# Use "ollama" for free local development (no API key required).
LLM_PROVIDER=ollama

# -- Ollama (local development) -----------------------------------------------
# URL of your running Ollama instance.  When using Docker Compose add an
# "ollama" service, or point to your host machine via host.docker.internal.
OLLAMA_BASE_URL=http://ollama:11434

# Chat / completion model (must be pulled first: ollama pull llama3.1:8b)
OLLAMA_MODEL=llama3.1:8b

# Embedding model (must be pulled first: ollama pull nomic-embed-text)
OLLAMA_EMBED_MODEL=nomic-embed-text

# -- OpenAI (production) ------------------------------------------------------
# Leave blank when using Ollama.  Required when LLM_PROVIDER=openai.
OPENAI_API_KEY=

# GPT model to use for completions
OPENAI_MODEL=gpt-4o

# OpenAI embedding model
OPENAI_EMBED_MODEL=text-embedding-3-small

# -- Google Gemini (alternative production) -----------------------------------
# Leave blank when using Ollama.  Required when LLM_PROVIDER=gemini.
GEMINI_API_KEY=

# Gemini completion model
GEMINI_MODEL=gemini-1.5-pro

# Gemini embedding model
GEMINI_EMBED_MODEL=text-embedding-004

# -----------------------------------------------------------------------------
# Security / JWT
# -----------------------------------------------------------------------------
# IMPORTANT: Change this in production!
# Generate a secure value with:  openssl rand -hex 32
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_USE_OPENSSL_RAND_HEX_32

# How long access tokens remain valid (minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# How long refresh tokens remain valid (days)
REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# Email (MailHog for development)
# -----------------------------------------------------------------------------
# MailHog listens on port 1025 (SMTP) and 8025 (Web UI).
# In production replace these with your real SMTP provider settings.
SMTP_HOST=mailhog
SMTP_PORT=1025

# Leave blank for MailHog (no auth required)
SMTP_USERNAME=
SMTP_PASSWORD=

# "From" address used in outbound emails
SMTP_FROM=noreply@resumeforge.local

# Email backend driver: smtp | console (console just prints to stdout)
EMAIL_BACKEND=smtp

# -----------------------------------------------------------------------------
# Frontend (Next.js)
# -----------------------------------------------------------------------------
# The URL the browser (not the server) uses to reach the backend API.
# In development this is always localhost because the browser runs on the host.
NEXT_PUBLIC_API_URL=http://localhost:8000
