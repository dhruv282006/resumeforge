# =============================================================================
# ResumeForge – Windows Native (Docker-Free) Environment Variables
# =============================================================================
# INSTRUCTIONS:
#   1. Copy this file to .env in the project root:
#        Copy-Item .env.windows.example .env
#   2. Adjust credentials if your local PostgreSQL or Redis use different settings.
#   3. NEVER commit your real .env file with production secrets to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME=ResumeForge
APP_VERSION=0.1.0

# Set to "true" to enable debug output and auto-reload
DEBUG=true

# One of: development | staging | production
ENVIRONMENT=development

# -----------------------------------------------------------------------------
# PostgreSQL Database (Windows Native)
# -----------------------------------------------------------------------------
# By default, Windows PostgreSQL installs with user "postgres".
# Adjust username, password, and port to match your local installation.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=resumeforge
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Async URL used by FastAPI, SQLAlchemy + asyncpg
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/resumeforge

# Sync URL used for direct tools or manual psql connections
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/resumeforge

# SQLAlchemy connection pool settings
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# -----------------------------------------------------------------------------
# Redis / Memurai (Windows Native)
# -----------------------------------------------------------------------------
# Connects to native Windows Memurai or Redis on localhost:6379
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# Celery (Async Task Queue on Windows)
# -----------------------------------------------------------------------------
# Broker: Redis database 0
CELERY_BROKER_URL=redis://localhost:6379/0

# Results backend: Redis database 1
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# NOTE: When starting Celery worker on Windows, always use the solo pool:
#   celery -A app.workers.celery_app worker --loglevel=info -P solo

# -----------------------------------------------------------------------------
# LLM / AI Provider
# -----------------------------------------------------------------------------
# Provider options: ollama | openai | gemini
# Use "ollama" for free, local inference via Ollama for Windows (http://localhost:11434).
LLM_PROVIDER=ollama

# -- Ollama (Windows native: https://ollama.com/download/windows) --------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text

# -- OpenAI (Optional cloud provider) -----------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_EMBED_MODEL=text-embedding-3-small

# -- Google Gemini (Optional cloud provider) ----------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro
GEMINI_EMBED_MODEL=text-embedding-004

# -----------------------------------------------------------------------------
# Security / JWT
# -----------------------------------------------------------------------------
# IMPORTANT: In production generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_USE_OPENSSL_RAND_HEX_32
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# Email (Development)
# -----------------------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@resumeforge.local
EMAIL_BACKEND=console

# -----------------------------------------------------------------------------
# Frontend (Next.js)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
